rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSmartGRUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@smartgr\\.com\\.br$');
    }

    // TODO: jacke@smartgr.com.br liberado só pra teste do fluxo de aprovação
    // sem precisar logar como Julia. Regra de negócio real é "só Julia
    // aprova" — remover esse e-mail antes de produção.
    function isAprovador() {
      return isSmartGRUser() && (
        request.auth.token.email == 'julia@smartgr.com.br' ||
        request.auth.token.email == 'jacke@smartgr.com.br'
      );
    }

    // Espelha frontend/src/main.js (TECNICAS_ATIVAS) e a coleção `tecnicas`
    // (scripts/seed-tecnicas.mjs) — Rules não faz query por campo (só get()
    // por id conhecido, e o id do doc em `tecnicas` é aleatório, não o
    // e-mail), então não dá pra checar "existe uma técnica com esse e-mail"
    // direto na coleção. Lista hardcoded, mesmo padrão já usado em
    // isAprovador(). Atualizar aqui + em main.js (e reployar as regras)
    // sempre que uma técnica entrar ou sair.
    function ehTecnica() {
      return isSmartGRUser() && request.auth.token.email in [
        'fernanda@smartgr.com.br',
        'mariana.cruz@smartgr.com.br',
        'vithoria@smartgr.com.br',
        'eloah@smartgr.com.br',
        'julia@smartgr.com.br'
      ];
    }

    // Antecedência mínima calculada em America/Sao_Paulo (UTC-3 fixo, sem
    // horário de verão desde 2019). Espelha frontend/src/utils/date-options.js
    // (diasAntecedenciaOk) — qualquer mudança em um lado precisa refletir no
    // outro. Único ponto de escrita real das solicitações é este (client SDK
    // grava direto no Firestore), então é aqui que o bloqueio não pode ser
    // burlado, mesmo chamando a REST API do Firestore diretamente.
    function diasAntecedenciaOk(dataStr, diasMinimos) {
      let partes = dataStr.split('-');
      let deslocamentoMs = 3 * 60 * 60 * 1000;
      let diaMs = 24 * 60 * 60 * 1000;
      // timestamp.date() dá meia-noite UTC daquele dia civil; meia-noite em
      // Brasília do MESMO dia civil é 3h depois em instante absoluto (UTC-3).
      let alvoBrasiliaMidnightMs = timestamp.date(int(partes[0]), int(partes[1]), int(partes[2])).toMillis() + deslocamentoMs;
      let hojeBrasiliaMidnightMs = ((request.time.toMillis() - deslocamentoMs) / diaMs) * diaMs + deslocamentoMs;
      return alvoBrasiliaMidnightMs >= hojeBrasiliaMidnightMs + (diasMinimos * diaMs);
    }

    // Firestore Rules não suporta o macro `.all()` de lista (não é CEL
    // completo) — indexação explícita é o jeito que realmente funciona.
    //
    // Mínimo relaxado: só 2 das 4 opções (único) / 1 das 2 opções (período)
    // precisa vir preenchida — o resto pode ficar em branco (string vazia).
    // Espelha frontend/src/utils/date-options.js (opcaoUnicoPreenchida /
    // dateOptionsValidas). Toda opção que VIER preenchida ainda precisa
    // respeitar a antecedência mínima — só a contagem de "quantas precisam
    // vir preenchidas" que baixou.
    function opcaoUnicoPreenchida(opcao) {
      return opcao.data is string && opcao.data.size() > 0;
    }

    function opcaoUnicoOk(opcao, diasMinimos) {
      return !opcaoUnicoPreenchida(opcao) || diasAntecedenciaOk(opcao.data, diasMinimos);
    }

    // Duas opções preenchidas com o mesmo data+horário não são duas
    // alternativas de verdade — espelha frontend/src/utils/date-options.js
    // (opcoesUnicoDuplicadas). Só compara opções já preenchidas.
    function opcaoUnicoIgual(a, b) {
      return opcaoUnicoPreenchida(a) && opcaoUnicoPreenchida(b)
        && a.data == b.data && a.horaInicio == b.horaInicio && a.horaTermino == b.horaTermino;
    }

    function opcoesUnicoSemDuplicata(opcoes) {
      return !opcaoUnicoIgual(opcoes[0], opcoes[1])
        && !opcaoUnicoIgual(opcoes[0], opcoes[2])
        && !opcaoUnicoIgual(opcoes[0], opcoes[3])
        && !opcaoUnicoIgual(opcoes[1], opcoes[2])
        && !opcaoUnicoIgual(opcoes[1], opcoes[3])
        && !opcaoUnicoIgual(opcoes[2], opcoes[3]);
    }

    function todasOpcoesUnicoOk(opcoes, diasMinimos) {
      return opcoes is list && opcoes.size() == 4
        && opcaoUnicoOk(opcoes[0], diasMinimos)
        && opcaoUnicoOk(opcoes[1], diasMinimos)
        && opcaoUnicoOk(opcoes[2], diasMinimos)
        && opcaoUnicoOk(opcoes[3], diasMinimos)
        && opcoesUnicoSemDuplicata(opcoes)
        && (
          (opcaoUnicoPreenchida(opcoes[0]) ? 1 : 0) +
          (opcaoUnicoPreenchida(opcoes[1]) ? 1 : 0) +
          (opcaoUnicoPreenchida(opcoes[2]) ? 1 : 0) +
          (opcaoUnicoPreenchida(opcoes[3]) ? 1 : 0)
        ) >= 2;
    }

    // tipoReserva === 'periodo': 2 opções de {dataInicio, dataFim, ...}. Só a
    // dataInicio de cada opção precisa da antecedência mínima; dataFim só
    // precisa não vir antes da dataInicio (comparação lexicográfica de string
    // funciona pra ISO YYYY-MM-DD).
    function opcaoPeriodoPreenchida(opcao) {
      return opcao.dataInicio is string && opcao.dataInicio.size() > 0
        && opcao.dataFim is string && opcao.dataFim.size() > 0;
    }

    function opcaoPeriodoOk(opcao, diasMinimos) {
      return !opcaoPeriodoPreenchida(opcao)
        || (opcao.dataFim >= opcao.dataInicio && diasAntecedenciaOk(opcao.dataInicio, diasMinimos));
    }

    // Mesma ideia de opcaoUnicoIgual, pro shape de período.
    function opcaoPeriodoIgual(a, b) {
      return opcaoPeriodoPreenchida(a) && opcaoPeriodoPreenchida(b)
        && a.dataInicio == b.dataInicio && a.dataFim == b.dataFim
        && a.horaInicio == b.horaInicio && a.horaTermino == b.horaTermino;
    }

    function todasOpcoesPeriodoOk(opcoes, diasMinimos) {
      return opcoes is list && opcoes.size() == 2
        && opcaoPeriodoOk(opcoes[0], diasMinimos)
        && opcaoPeriodoOk(opcoes[1], diasMinimos)
        && !opcaoPeriodoIgual(opcoes[0], opcoes[1])
        && (
          (opcaoPeriodoPreenchida(opcoes[0]) ? 1 : 0) +
          (opcaoPeriodoPreenchida(opcoes[1]) ? 1 : 0)
        ) >= 1;
    }

    // Recebe o documento inteiro (não só opcoesData) pra poder ler
    // tipoReserva. Documentos antigos sem o campo (antes dessa feature)
    // continuam tratados como 'unico' — só create passa por aqui, e create
    // sempre é de documento novo, então "antigo" aqui só importa pra não
    // quebrar se algum client mandar o campo ausente por engano.
    function todasOpcoesDataOk(dados, diasMinimos) {
      return (!('tipoReserva' in dados) || dados.tipoReserva == 'unico')
        ? todasOpcoesUnicoOk(dados.opcoesData, diasMinimos)
        : todasOpcoesPeriodoOk(dados.opcoesData, diasMinimos);
    }

    // Até 5 técnicas no mesmo evento (frontend/src/pages/painel-julia.js,
    // "+ Adicionar nova técnica") — sufixo '' é a principal (compatível com
    // documentos antigos), '2'..'5' são as extras. Mesma lista em
    // frontend/src/pages/painel-julia.js e minhas-solicitacoes.js (SUFIXOS_TECNICA)
    // — mudar aqui sem mudar lá quebra a recusa/leitura pros slots novos.
    function ehDonaDoSlot(dados, sufixo) {
      let campoEmail = 'tecnicaEmail' + sufixo;
      return (campoEmail in dados) && dados[campoEmail] == request.auth.token.email;
    }

    // Técnica recusando o PRÓPRIO treinamento já aprovado (fora do
    // expediente — fim de semana/feriado/fora 08:30-17:30, checado no
    // frontend em utils/expediente.js). Só pode zerar o slot que é dela
    // (tecnicaEmail{sufixo}/tecnicaAtribuida{sufixo}/googleEvent...{sufixo})
    // e anexar o registro em recusasTecnica — nada mais no documento pode
    // mudar nessa via. Qualquer outra alteração (reatribuir, mudar status,
    // opcoesData etc.) continua exclusiva da Julia.
    function recusaValidaDoSlot(dadosAntigos, dadosNovos, sufixo, chaves) {
      return ehDonaDoSlot(dadosAntigos, sufixo)
        && chaves.hasOnly([
          'tecnicaAtribuida' + sufixo, 'tecnicaEmail' + sufixo,
          'googleEventId' + sufixo, 'googleEventLink' + sufixo, 'googleMeetLink' + sufixo,
          'recusasTecnica'
        ])
        && dadosNovos['tecnicaEmail' + sufixo] == null
        && dadosNovos['tecnicaAtribuida' + sufixo] == null;
    }

    function recusaValidaDaTecnica(dadosAntigos, dadosNovos) {
      let chaves = request.resource.data.diff(resource.data).affectedKeys();
      return isSmartGRUser()
        && dadosAntigos.status == 'aprovado' && dadosNovos.status == 'aprovado'
        && (
          recusaValidaDoSlot(dadosAntigos, dadosNovos, '', chaves) ||
          recusaValidaDoSlot(dadosAntigos, dadosNovos, '2', chaves) ||
          recusaValidaDoSlot(dadosAntigos, dadosNovos, '3', chaves) ||
          recusaValidaDoSlot(dadosAntigos, dadosNovos, '4', chaves) ||
          recusaValidaDoSlot(dadosAntigos, dadosNovos, '5', chaves)
        );
    }

    // Pra regra de leitura: dona de QUALQUER um dos 5 slots.
    function ehDonaDeAlgumSlot(dados) {
      return ehDonaDoSlot(dados, '') || ehDonaDoSlot(dados, '2') || ehDonaDoSlot(dados, '3')
        || ehDonaDoSlot(dados, '4') || ehDonaDoSlot(dados, '5');
    }

    // Só leitura para o client. Escrita (inclusive token OAuth) só via Admin SDK
    // (workers/calendar), que ignora estas regras.
    match /tecnicas/{id} {
      allow read: if isSmartGRUser();
      allow write: if false;
    }

    // Read (get + list): quem aprova vê tudo; vendedor e técnica só
    // enxergam a própria solicitação (não a fila alheia). Create continua
    // aberto pra qualquer @smartgr.com.br — é o formulário público.
    match /solicitacoes_consumidor_final/{id} {
      // Além da Julia: o vendedor que enviou (vendedorEmail) e a técnica
      // atribuída (tecnicaEmail, denormalizado na aprovação) enxergam a
      // própria solicitação — não a fila inteira.
      allow read: if isAprovador()
        || (isSmartGRUser() && resource.data.vendedorEmail == request.auth.token.email)
        || (isSmartGRUser() && ehDonaDeAlgumSlot(resource.data));
      allow create: if isSmartGRUser() && todasOpcoesDataOk(request.resource.data, 7);
      allow update: if isAprovador() || recusaValidaDaTecnica(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /solicitacoes_revenda/{id} {
      // Além da Julia: o vendedor que enviou (vendedorEmail) e a técnica
      // atribuída (tecnicaEmail, denormalizado na aprovação) enxergam a
      // própria solicitação — não a fila inteira.
      allow read: if isAprovador()
        || (isSmartGRUser() && resource.data.vendedorEmail == request.auth.token.email)
        || (isSmartGRUser() && ehDonaDeAlgumSlot(resource.data));
      allow create: if isSmartGRUser() && todasOpcoesDataOk(request.resource.data, 7);
      allow update: if isAprovador() || recusaValidaDaTecnica(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /solicitacoes_workshop/{id} {
      // Além da Julia: o vendedor que enviou (vendedorEmail) e a técnica
      // atribuída (tecnicaEmail, denormalizado na aprovação) enxergam a
      // própria solicitação — não a fila inteira.
      allow read: if isAprovador()
        || (isSmartGRUser() && resource.data.vendedorEmail == request.auth.token.email)
        || (isSmartGRUser() && ehDonaDeAlgumSlot(resource.data));
      allow create: if isSmartGRUser() && todasOpcoesDataOk(request.resource.data, 7);
      allow update: if isAprovador() || recusaValidaDaTecnica(resource.data, request.resource.data);
      allow delete: if false;
    }

    // Escala geral (grade semanal/diária) — não nasce de solicitação, não
    // tem vendedor nem técnica "dona". Só técnicas (ehTecnica) + quem já
    // tinha acesso de aprovador veem/editam a grade de todo mundo — não é
    // qualquer conta @smartgr.com.br (vendedor, por exemplo, não entra).
    match /escalas/{id} {
      allow read, write: if isAprovador() || ehTecnica();
    }
  }
}
